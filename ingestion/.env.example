# Copy to ingestion/.env (gitignored). Anything exported in the shell wins;
# anything missing here is also looked up in ../app/.env.local.
#
# Nothing in this pipeline calls a paid API: embeddings and the contextual
# preamble both run against a local Ollama server.

# Local Supabase. `supabase start` prints these; the service role bypasses RLS
# and must never reach the browser.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=

# Local Ollama.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=mxbai-embed-large
CONTEXT_MODEL=qwen2.5:14b

# Set to 1 to run the pipeline with context_summary = '' throughout.
SKIP_CONTEXTUALIZE=
