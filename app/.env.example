# Chat model, via any OpenAI-compatible endpoint.
# Defaults below run entirely on local Ollama — no key, no per-token cost.
# Swap LLM_BASE_URL for a hosted OpenAI-compatible endpoint (Groq, Gemini's
# compatibility layer, OpenRouter) without touching code. Check that
# endpoint's pricing first: hosted inference may bill per token.
#
# The hosted demo uses Groq's free tier, which requires a model that does tool
# calling — HAI cannot answer without calling search_standards:
#
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_API_KEY=gsk_...        # https://console.groq.com/keys
#   LLM_REASONING_FORMAT=hidden
#
# Groq retired every Llama and Kimi-K2 model on 2026-08-16, so an older guide
# naming llama-3.3-70b-versatile will fail with a 404 model_not_found. Check
# https://console.groq.com/docs/deprecations before pinning a model.
#
# LLM_REASONING_FORMAT is passed straight through to the endpoint. Set it to
# "hidden" with any reasoning model: otherwise the model returns
# reasoning_content, the SDK echoes it back on the next step of the tool loop,
# and Groq rejects its own field — the search succeeds and the answer never
# arrives. Leave it unset for local Ollama and for endpoints that reject
# unknown body parameters. See docs/DEPLOY.md.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama

# Optional. The model /api/deliverables uses; defaults to LLM_MODEL.
#
# Worth setting on a hosted deployment, because Groq's token buckets are per
# model — both the per-minute one and the per-day one. Verified against the
# deployed key: qwen/qwen3.8-27b and openai/gpt-oss-120b each reported their own
# independent 8,000 tokens/minute and decremented separately.
#
# A situation brief costs roughly 25,000 tokens against a 200,000/day ceiling,
# so sharing one model with chat means a busy chat afternoon quietly consumes
# the ability to produce a document. Pointing deliverables at a second model
# gives the two features independent daily budgets on the same key.
#
#   LLM_DELIVERABLES_MODEL=openai/gpt-oss-120b   # hosted demo's value
LLM_DELIVERABLES_MODEL=

# Optional. Only if deliverables should use a different provider entirely
# rather than a second model on the same one. Each falls back to its LLM_*
# equivalent.
LLM_DELIVERABLES_BASE_URL=
LLM_DELIVERABLES_API_KEY=

# IMPORTANT for local Ollama: the 4096-token default context is too small for
# HAI, and overflowing it silently drops the system prompt — after which the
# model loses its grounding and language rules mid-answer. Either build the
# provided variant, which bakes in a 16k context:
#
#   ollama create hai-qwen2.5 -f app/ollama/Modelfile
#   LLM_MODEL=hai-qwen2.5
#
# ...or raise it server-wide and restart Ollama:
#   launchctl setenv OLLAMA_CONTEXT_LENGTH 16384   # macOS app
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve       # foreground
#
# Verify with: curl -s localhost:11434/api/ps | grep context_length

# Query embeddings for the search_standards tool. Must come from the same model
# the corpus was ingested with (see ingestion/embed.ts): a different model at the
# same 1024 dimensions produces vectors of the right shape in the wrong space,
# and every search then ranks by noise while looking perfectly healthy.
#
#   ollama  (default) local Ollama. Free, no key.
#   hf      Hugging Face Inference, serving mixedbread-ai/mxbai-embed-large-v1 —
#           the upstream of Ollama's mxbai-embed-large, so vectors stay
#           compatible with a corpus embedded locally.
EMBEDDINGS_PROVIDER=ollama

# Used when EMBEDDINGS_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=mxbai-embed-large

# Used when EMBEDDINGS_PROVIDER=hf. Create at
# https://huggingface.co/settings/tokens with the "Inference Providers"
# permission. A free account carries a small monthly inference credit
# (~$0.10); when it runs out, requests fail rather than bill, and HAI degrades
# to full-text-only search with a visible notice.
HF_TOKEN=

# Supabase (server-side, pgvector search). RLS on standards_chunks grants
# SELECT only, so the anon key is safe to use here — no service role needed
# for search. Local stack: `supabase status` from the repo root.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=

# Optional. ReliefWeb's JSON API requires an appname pre-approved by OCHA
# (https://apidoc.reliefweb.int/parameters#appname). Without it, crisis_updates
# falls back to IFRC GO, which needs no registration.
RELIEFWEB_APPNAME=

# Optional. HDX HAPI attribution string: base64 of "appname:email".
# Defaults to a demo identifier; no registration required either way.
HDX_APP_IDENTIFIER=

# Cost / abuse controls
#
# RATE_LIMIT_RPM paces one client: a per-IP sliding window, default 20/min. It
# lives in process memory, so on Vercel each serverless instance keeps its own
# copy and it resets on every deploy — a politeness control, not a spend control.
#
# It governs /api/chat only. /api/deliverables keeps its own, much tighter
# counter (3 runs per 10 minutes, not configurable), because one run is about
# nineteen model calls rather than one.
RATE_LIMIT_RPM=

# LLM_TOKENS_PER_MINUTE no longer needs setting on an ordinary hosted
# deployment, and its meaning has narrowed.
#
# /api/deliverables now reads x-ratelimit-* off every response (see
# src/lib/llm/rate-limit.ts) and paces against the endpoint's own numbers rather
# than a configured guess, so Groq's free tier and a paid tier are both paced
# correctly with no configuration. Pacing switches itself on when an endpoint
# reports a ceiling and stays off when none is reported — a local Ollama is
# never paced, and no URL check decides that.
#
# What this variable is for now is the endpoint that enforces a ceiling but does
# not report it in headers: set it to that ceiling in tokens per minute. A
# reported limit always wins over it. Leave it unset otherwise.
#
# Only the deliverables engine reads it; chat is one call at a time and never
# approaches the limit.
LLM_TOKENS_PER_MINUTE=

# MAX_DAILY_REQUESTS is the spend control: one shared counter in Postgres,
# default 500/day across the whole deployment, enforced atomically so concurrent
# instances cannot overshoot it. Requires the daily_request_cap migration.
#
# Ignored entirely when LLM_BASE_URL points at localhost, where inference is free
# and a ceiling would only cap your own demo — set it explicitly to exercise the
# enforcement path locally.
MAX_DAILY_REQUESTS=

# Data-responsibility screening.
#
# The deterministic pass (regex + heuristics over phone numbers, emails, case
# and registration identifiers, GPS coordinates, dates of birth, and pasted
# person rosters) always runs and costs microseconds. It cannot see a bare
# personal name.
#
# Setting PII_LLM_SCREEN=true adds a second-pass classification call in front of
# every message the regexes cleared, catching bare names and re-identifying
# detail combinations. It is off by default because it is a full model
# round-trip paid before the first token of the answer. Measured on a loaded
# Apple-silicon laptop with local Ollama: qwen2.5:14b took 3.2s on a trivial
# prompt when quiet and 69s or more on the real 221-token screen prompt under
# contention. It fails open on timeout, so on a busy machine it costs latency
# and buys nothing. Enable it against an endpoint that can classify in about a
# second.
PII_LLM_SCREEN=false

# Optional. Model for that second pass; defaults to LLM_MODEL. Pick for
# judgement, not size: phi3.5 obeyed the format but missed a personal name, and
# nuextract ignored the yes/no instruction entirely and replied with extracted
# prose. Both were measured; neither is recommended.
PII_SCREEN_MODEL=

# Optional. Milliseconds before the second pass gives up and lets the request
# through. Default 8000.
PII_SCREEN_TIMEOUT_MS=
