# Chat model, via any OpenAI-compatible endpoint.
# Defaults below run entirely on local Ollama — no key, no per-token cost.
# Swap LLM_BASE_URL for a hosted OpenAI-compatible endpoint (Groq, Gemini's
# compatibility layer, OpenRouter) without touching code. Check that
# endpoint's pricing first: hosted inference may bill per token.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=ollama

# Voyage AI embeddings for corpus ingestion + search_standards tool
VOYAGE_API_KEY=

# Supabase (server-side, pgvector search + writes) — keep the service role
# key server-only, never expose it to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side, public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. ReliefWeb's JSON API requires an appname pre-approved by OCHA
# (https://apidoc.reliefweb.int/parameters#appname). Without it, crisis_updates
# falls back to IFRC GO, which needs no registration.
RELIEFWEB_APPNAME=

# Optional. HDX HAPI attribution string: base64 of "appname:email".
# Defaults to a demo identifier; no registration required either way.
HDX_APP_IDENTIFIER=

# Cost / abuse controls
RATE_LIMIT_RPM=
