# Humanitarian LLM POC - Environment Configuration

# ============================================================================
# API Keys (DO NOT COMMIT ACTUAL KEYS)
# ============================================================================

# Anthropic API (for Claude Haiku/Sonnet in Petri)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API (free tier for testing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# Model Configuration
# ============================================================================

# Local Model (Ollama)
LOCAL_MODEL=llama3.3:8b
LOCAL_MODEL_URL=http://localhost:11434

# Petri Model Roles
PETRI_AUDITOR_MODEL=openrouter/meta-llama/llama-4-scout
PETRI_TARGET_MODEL=ollama/llama3.3:8b
PETRI_JUDGE_MODEL=anthropic/claude-haiku-4

# Premium Validation Model
VALIDATION_MODEL=anthropic/claude-sonnet-4.5

# ============================================================================
# Cost Optimization Settings
# ============================================================================

# Maximum budget in USD
MAX_BUDGET=200

# Cost tracking
ENABLE_COST_TRACKING=true
COST_TRACKING_FILE=reports/cost-tracking.json

# Token limits per test
MAX_TOKENS_PER_TEST=5000
MAX_TOKENS_AUDITOR=3000
MAX_TOKENS_TARGET=3000
MAX_TOKENS_JUDGE=2000

# ============================================================================
# Petri Configuration
# ============================================================================

# Number of test scenarios
PETRI_NUM_SCENARIOS=25
PETRI_PARALLEL_TESTS=3

# Petri output directory
PETRI_RESULTS_DIR=petri/results
PETRI_SEEDS_DIR=petri/seeds

# ============================================================================
# ACE (Agentic Context Engineering) Configuration
# ============================================================================

# ACE processing model (local to save costs)
ACE_MODEL=ollama/llama3.3:8b

# ACE iteration settings
ACE_MAX_ITERATIONS=5
ACE_REFLECTION_DEPTH=3

# ACE output directories
ACE_CONTEXTS_DIR=ace/contexts
ACE_PLAYBOOKS_DIR=ace/playbooks

# ============================================================================
# Fine-Tuning Configuration
# ============================================================================

# Training data paths
TRAINING_DATA_DIR=data/training
PROCESSED_DATA_DIR=data/processed

# LoRA settings
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05

# Training parameters
LEARNING_RATE=2e-4
BATCH_SIZE=4
NUM_EPOCHS=3
MAX_SEQ_LENGTH=2048

# Model output
MODEL_OUTPUT_DIR=models/outputs
CHECKPOINT_DIR=models/checkpoints

# ============================================================================
# Data Extraction Configuration
# ============================================================================

# CLEAR docs source directory
CLEAR_DOCS_DIR=../docs

# Humanitarian knowledge filters
EXTRACT_CRISIS_TYPES=true
EXTRACT_STATISTICS=true
EXTRACT_WORKFLOWS=true
EXTRACT_DECISION_FRAMEWORKS=true

# Output format
KNOWLEDGE_BASE_FORMAT=jsonl
KNOWLEDGE_BASE_OUTPUT=data/processed/humanitarian_knowledge.jsonl

# ============================================================================
# Logging and Monitoring
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=reports/execution.log

# Performance tracking
TRACK_PERFORMANCE=true
PERFORMANCE_REPORT=reports/performance-metrics.json

# ============================================================================
# Safety and Validation
# ============================================================================

# Humanitarian principles validation
VALIDATE_UN_PRINCIPLES=true
VALIDATE_ETHICS=true
VALIDATE_CULTURAL_SENSITIVITY=true

# Safety thresholds
MIN_ACCURACY_THRESHOLD=0.85
MAX_HARMFUL_RESPONSES=0

# ============================================================================
# Production Settings (for post-POC)
# ============================================================================

# Deployment mode
DEPLOYMENT_MODE=development

# Rate limiting (queries per hour)
RATE_LIMIT_QPH=1000

# Caching
ENABLE_PROMPT_CACHING=true
CACHE_TTL_SECONDS=3600
